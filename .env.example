# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (must run on port 3000 in AI Studio)
PORT=3000

# RAZORPAY CONFIGURATION (Optional - for live Indian payment processing)
# When not provisioned, SmartGrow AI runs in sandbox mode with full checkout simulation.
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# FIREBASE CONFIGURATION
# Production Firebase Auth & Cloud Firestore are provisioned via firebase-applet-config.json.
