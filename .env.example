# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (3000 required for AI Studio)
PORT=3000

# RAZORPAY CONFIGURATION (Optional - for live Indian payment gateway integration)
# In development without keys, SmartGrow AI automatically runs in demo sandbox mode.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# FIREBASE FIRESTORE & AUTHENTICATION (Optional)
# If provided, enables live cloud synchronization. Otherwise, SmartGrow AI runs on local server persistence.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

